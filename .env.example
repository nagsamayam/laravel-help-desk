APP_NAME="Help Desk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

AUTH_GUARD=api
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL / Docker)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_help_desk
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting, Storage & Queue
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis Configuration & Docker Port
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# Laravel Horizon
HORIZON_PREFIX=
HORIZON_PATH=horizon

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (for Ticket Attachments / Cloud Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend / Vite
VITE_APP_NAME="${APP_NAME}"

# JWT Authentication
JWT_ALGO=RS512
JWT_PRIVATE_KEY="file://storage/app/keys/jwt-rsa-4096-private.pem"
JWT_PUBLIC_KEY="file://storage/app/keys/jwt-rsa-4096-public.pem"
JWT_PASSPHRASE=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# API Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_REDIS_ENABLED=true
IDEMPOTENCY_REDIS_STORE=redis
IDEMPOTENCY_REDIS_PREFIX=idempotency
IDEMPOTENCY_REDIS_LOCK_SECONDS=30
IDEMPOTENCY_REDIS_LOCK_WAIT_SECONDS=5

# Laravel Reverb (WebSockets)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# PMM
PMM_AGENT_SERVER_PASSWORD=
PMM_AGENT_SETUP_PASSWORD=
PMM_AGENT_SETUP_HOST=mysql
PMM_AGENT_SETUP_PORT=3306
PMM_AGENT_SETUP_USER=pmm_monitor
